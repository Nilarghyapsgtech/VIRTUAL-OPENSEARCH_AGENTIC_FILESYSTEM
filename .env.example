# Local Docker Compose uses OpenSearch with security disabled for development.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_TIMEOUT=20

OSFS_INDEX_PREFIX=osfs
OSFS_DEFAULT_TENANT=demo
OSFS_DEFAULT_COLLECTION=docs
OSFS_DEFAULT_PRINCIPALS=group:public
OSFS_CHUNK_LINES=200
OSFS_MAX_CAT_BYTES=1000000
OSFS_MAX_SHELL_OUTPUT_BYTES=500000
OSFS_MAX_SEARCH_HITS=5000
OSFS_ENABLE_LOCAL_INGEST=true
OSFS_INGEST_BASE_DIR=/data/ingest
